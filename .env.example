# ── Banco de Dados (PostgreSQL / Supabase) ──────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SuaSenhaAqui
POSTGRES_DB=postgres
POSTGRES_HOST=db.SEU-PROJETO.supabase.co

# ── Usuários da aplicação ────────────────────────────────────────────────────
APP_DEMO_PASSWORD=SenhaDemoAqui
APP_ADMIN_PASSWORD=SenhaAdminAqui
APP_ADMIN_LOGIN=seu-email@exemplo.com

# ── JWT ──────────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
JWT_SECRET=GERE_UMA_CHAVE_BASE64_ALEATORIA_AQUI

# ── RabbitMQ (opcional em dev — padrão: guest/guest) ─────────────────────────
# Em dev com Docker, o docker-compose usa "guest" por padrão.
# Em produção (EC2), defina credenciais fortes:
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ── Apenas em produção ───────────────────────────────────────────────────────
SUPABASE_DB_PASSWORD=
SSL_KEYSTORE_PASSWORD=
# RABBITMQ_HOST=localhost   # em prod: localhost (Rabbit na mesma EC2)
# RABBITMQ_USERNAME=domus
# RABBITMQ_PASSWORD=SenhaForteAqui
